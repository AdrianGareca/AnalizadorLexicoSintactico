<Project Sdk="Microsoft.NET.Sdk">

  <!-- Programa de consola para probar el léxico y el sintáctico sin la ventana.
       Funciona en Windows, Mac y Linux (ver COMO-TRABAJAR.md, "Probar sin la ventana"). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../AnalizadorLexicoSintactico/Lexico/*.cs" />
    <Compile Include="../AnalizadorLexicoSintactico/Sintactico/*.cs" />
    <Compile Include="../AnalizadorLexicoSintactico/Comun/ErrorAnalisis.cs" />
  </ItemGroup>

</Project>
